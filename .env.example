# .env.example — SleepFM Interpretability environment configuration
#
# Copy this to `.env` and customize; .env is git-ignored. Load with:
#   PowerShell (correct syntax for dynamic env-var assignment):
#     Get-Content .env | Where-Object { $_ -notmatch '^\s*($|#)' } |
#       ForEach-Object { $k,$v = $_.Split('=',2); Set-Item -Path "env:$k" -Value $v }
#   bash:  set -a; source .env; set +a
#
# Or export inline before running scripts:
#   $env:SLEEPFM_COHORT_ROOT = "..."

# ---- Cohort layout ----------------------------------------------------------
# Root directory containing embeddings/ and (optionally) metadata.csv, xml/
SLEEPFM_COHORT_ROOT=C:/Users/YOU/Desktop/Projeler/sleepfm_interpretability/data/clean_cohort_run

# Absolute path to MESA harmonized metadata CSV (age, sex, BMI, AHI, ODI)
# NSRR MESA datasets folder → mesa-sleep-dataset-0.8.0.csv
SLEEPFM_METADATA_CSV=C:/Users/YOU/Desktop/Projeler/SleepFM/mesa/.csv/mesa-sleep-dataset-0.8.0.csv

# Directory containing MESA polysomnography XML annotations (mesa-sleep-*-nsrr.xml)
SLEEPFM_MESA_XML_DIR=C:/Users/YOU/Desktop/Projeler/SleepFM/mesa_test_clean

# Strict mode: any call to resolve_cohort() without SLEEPFM_COHORT_ROOT raises
# instead of silently falling back to the contaminated smoke_run cohort.
# Recommended for CI and production runs. Set to 1 to enable.
# SLEEPFM_FORBID_LEGACY_FALLBACK=1

# ---- clinical-bridge sibling repo -------------------------------------------
# Absolute path to the clinical-bridge repo (sibling of this repo). Required by
# clinical_bridge_adapter for FHIR RiskAssessment translation.
CLINICAL_BRIDGE_DIR=C:/Users/YOU/Desktop/Projeler/clinical-bridge-main

# ---- SleepFM upstream repo --------------------------------------------------
# Absolute path to sleepFMoriginal/sleepfm-clinical (needed by
# scripts/verify_cohort_pretrain_independence.py for dataset_split.json)
SLEEPFM_UPSTREAM_DIR=C:/Users/YOU/Desktop/Projeler/SleepFM/sleepFMoriginal/sleepfm-clinical

# ---- NSRR download ---------------------------------------------------------
# Directory to download NSRR EDF/XML into (used by scripts/download_nsrr_mesa.py
# as --out default when the flag isn't passed)
NSRR_DOWNLOAD_OUT=C:/Users/YOU/Desktop/Projeler/SleepFM/mesa_test_clean

# NSRR token file (secure — do not put token in argv or environment directly)
# See REPRODUCE.md §3 for secure setup instructions.
NSRR_TOKEN_FILE=C:/Users/YOU/.nsrr/token
